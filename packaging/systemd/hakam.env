# Hakam systemd configuration — installed to /etc/hakam/hakam.env
# Edit HAKAM_IFACE to your box's interface before `systemctl start hakam`.

# Interface to attach XDP + TC to. Find yours with: ip -br link
HAKAM_IFACE=eth0

# XDP attach mode. "skb" (generic) works on every NIC and in a VM; "driver" is
# faster but needs NIC driver support (roadmap #10). Start with skb.
HAKAM_MODE=skb

# Address the telemetry WebSocket binds to. 0.0.0.0 lets a remote HUD connect;
# use 127.0.0.1 to keep it local-only.
HAKAM_BIND=0.0.0.0

# Path to the compiled eBPF object (installed by packaging/install.sh).
HAKAM_BPF_PATH=/usr/local/lib/hakam/hakam-ebpf
