# Copy to `.env` (or `.env.local`) to override the default WebSocket endpoint.
#
# Default (no override): the UI connects to ws://localhost:8080/ws.
# Use this with an SSH tunnel from your Mac:
#   ssh -L 8080:localhost:8080 user@<linux-vm-ip>
#
# Direct mode (no tunnel): point straight at the Linux server.
# phantom-node already binds to 0.0.0.0 so this works out of the box,
# as long as the VM's port 8080 is reachable from your Mac.
#
# VITE_PHANTOM_WS_URL=ws://192.168.64.4:8080/ws
